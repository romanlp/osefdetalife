rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Validation helpers ---

    function validateRestaurantData(data) {
      return data.name is string
        && data.name.size() > 0
        && data.slug is string
        && data.slug.size() > 0
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.timezone is string;
    }

    function validateBookingData(data) {
      return data.date is string
        && data.date.size() > 0
        && data.time is string
        && data.time.size() > 0
        && data.partySize is number
        && data.partySize > 0
        && data.name is string
        && data.name.size() > 0
        && data.email is string
        && data.email.size() > 0
        && data.status == 'confirmed'
        && data.restaurantId is string;
    }

    // AD-14 public projection: availability-only fields, no diner PII.
    function validatePublicBookingData(data) {
      return data.date is string
        && data.date.size() > 0
        && data.time is string
        && data.time.size() > 0
        && data.partySize is number
        && data.partySize > 0
        && data.status == 'confirmed'
        && data.restaurantId is string
        && !('name' in data)
        && !('email' in data)
        && !('customFieldValue' in data);
    }

    function isExistingRestaurant(restaurantId) {
      return exists(/databases/$(database)/documents/restaurants/$(restaurantId));
    }

    function isOwner(restaurantId) {
      return request.auth != null
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    // --- Restaurants ---

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId
                    && validateRestaurantData(request.resource.data);
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      // Table groups — public read, owner write
      match /tables/{tableId} {
        allow read: if true;
        allow create, update: if isOwner(restaurantId)
                              && request.resource.data.capacity is number
                              && request.resource.data.capacity > 0
                              && request.resource.data.count is number
                              && request.resource.data.count > 0;
        allow delete: if isOwner(restaurantId);
      }

      // Bookings — unauthenticated create with validation, owner-only read (contains diner PII)
      match /bookings/{bookingId} {
        allow read: if isOwner(restaurantId);
        allow create: if validateBookingData(request.resource.data)
                      && request.resource.data.restaurantId == restaurantId
                      && isExistingRestaurant(request.resource.data.restaurantId);
        allow update: if isOwner(restaurantId)
                      && request.resource.data.status == 'cancelled'
                      && resource.data.status == 'confirmed';
        allow delete: if false;
      }

      // Bookings public projection (AD-14) — non-PII availability fields, public read.
      // Mirrors bookings/{bookingId} with only date/time/partySize/status for the
      // public booking page's availability calculation. Written in the same batch as
      // the full booking. PII fields are rejected on write.
      match /bookings-public/{bookingId} {
        allow read: if true;
        allow create: if validatePublicBookingData(request.resource.data)
                      && request.resource.data.restaurantId == restaurantId
                      && isExistingRestaurant(request.resource.data.restaurantId);
        allow update: if isOwner(restaurantId)
                      && request.resource.data.status == 'cancelled'
                      && resource.data.status == 'confirmed';
        allow delete: if false;
      }
    }

    function validateSlug(slug) {
      return slug is string
        && slug.matches('^[a-z0-9-]{3,64}$')
        && !slug.matches('^-|-$')
        && !slug.matches('--');
    }

    function isSlugOwner(slug) {
      return request.auth != null
        && exists(/databases/$(database)/documents/slugs/$(slug))
        && get(/databases/$(database)/documents/slugs/$(slug)).data.restaurantId is string
        && get(/databases/$(database)/documents/restaurants/$(get(/databases/$(database)/documents/slugs/$(slug)).data.restaurantId)).data.ownerId == request.auth.uid;
    }

    // --- Slug resolution ---

    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null
                        && validateSlug(slug)
                        && request.resource.data.restaurantId is string;
      allow update, delete: if isSlugOwner(slug);
    }
  }
}
